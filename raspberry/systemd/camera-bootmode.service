[Unit]
Description=Camera Viewer - boot mode selector (provisioning vs operational)
After=NetworkManager.service camera-network-mode.service
Wants=NetworkManager.service
# AP deve essere attivo PRIMA che il portale web inizi a servire richieste
Before=camera-webconfig.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/cv-bootmode
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

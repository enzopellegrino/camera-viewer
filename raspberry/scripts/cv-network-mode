#!/bin/bash
# cv-network-mode — Gestisce la modalità rete al boot.
#
# Se ethernet non è disponibile entro 30s, crea un hotspot WiFi
# così il cliente può configurare la rete dal portale senza ethernet.
#
# Hotspot: Camera-Viewer (aperto, nessuna password)
# IP portale in AP mode: http://10.42.0.1
#
set -euo pipefail

LOG="/tmp/cv-network.log"
AP_SSID="Camera-Viewer"
AP_PASS="cameraviewer"   # Password hotspot (min 8 caratteri, WPA2)
AP_IP="10.42.0.1"
WAIT_SECONDS=30

log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "$LOG"; }

has_ethernet() {
    nmcli -t -f TYPE,STATE dev status 2>/dev/null | grep -q "ethernet:connected"
}

has_wifi() {
    nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep -q ":wifi$"
}

log "Verifica connessione rete..."

# Aspetta ethernet per WAIT_SECONDS secondi
for i in $(seq 1 $WAIT_SECONDS); do
    if has_ethernet; then
        log "Ethernet connessa — modalità normale."
        exit 0
    fi
    sleep 1
done

log "Nessun ethernet dopo ${WAIT_SECONDS}s."

# Controlla se c'è WiFi disponibile
if ! has_wifi; then
    log "Nessuna interfaccia WiFi — impossibile creare hotspot."
    exit 0
fi

WIFI_IF=$(nmcli -t -f DEVICE,TYPE dev 2>/dev/null | grep ":wifi$" | cut -d: -f1 | head -1)
log "Interfaccia WiFi: $WIFI_IF"

# Rimuovi hotspot precedente se esiste
nmcli con delete "Camera-Viewer-AP" 2>/dev/null || true

log "Avvio hotspot WiFi '$AP_SSID'..."

# Crea hotspot aperto (nessuna password — il portale gestisce l'auth)
# Crea hotspot WPA2 con password (richiesto da Intel iwlwifi — no open AP)
nmcli dev wifi hotspot \
    ifname "$WIFI_IF" \
    ssid "$AP_SSID" \
    password "$AP_PASS" 2>/dev/null || \
nmcli con add type wifi ifname "$WIFI_IF" \
    con-name "Camera-Viewer-AP" \
    ssid "$AP_SSID" \
    mode ap \
    ipv4.method shared \
    ipv4.addresses "${AP_IP}/24" \
    wifi-sec.key-mgmt wpa-psk \
    wifi-sec.psk "$AP_PASS" 2>/dev/null

nmcli con up "Camera-Viewer-AP" 2>/dev/null || true
sleep 3

# Configura il portale in modalità AP
# Imposta PORTAL_HOST così le redirect captive portal puntano all'IP giusto
mkdir -p /etc/systemd/system/camera-webconfig.service.d
cat > /etc/systemd/system/camera-webconfig.service.d/ap-mode.conf << EOF
[Service]
Environment=PORTAL_HOST=${AP_IP}
Environment=HOST=0.0.0.0
Environment=PORT=80
EOF

# Redirects captive portal: iOS/Android aprono automaticamente il browser
iptables -t nat -A PREROUTING -i "$WIFI_IF" -p tcp --dport 80 \
    -j DNAT --to-destination ${AP_IP}:80 2>/dev/null || true
iptables -t nat -A PREROUTING -i "$WIFI_IF" -p tcp --dport 443 \
    -j DNAT --to-destination ${AP_IP}:80 2>/dev/null || true

systemctl daemon-reload
systemctl restart camera-webconfig

log "Hotspot attivo: '$AP_SSID' → http://${AP_IP}"
log "Connettiti alla rete WiFi '$AP_SSID' e apri http://${AP_IP}"

# Scrivi stato AP per l'overlay su schermo
echo "$AP_SSID|$AP_IP" > /tmp/cv-ap-mode

# Mostra overlay sullo schermo con info WiFi + password
# Lancia come utente pi con accesso a X11 (il dispatcher gira come root)
pkill -f "xterm.*Camera-Viewer-AP" 2>/dev/null || true
sudo -u pi bash -c "
DISPLAY=:0
XAUTHORITY=/home/pi/.Xauthority
export DISPLAY XAUTHORITY
xterm -T 'Camera-Viewer-AP' \
    -fa 'Monospace' -fs 16 \
    -bg '#0c0e18' -fg '#4f72f7' \
    -geometry 58x14+0+0 \
    -e bash -c '
while true; do
clear
echo \"\"
echo \"  ╔══════════════════════════════════════════════╗\"
echo \"  ║   🎥  Camera Viewer v2.0                     ║\"
echo \"  ╠══════════════════════════════════════════════╣\"
echo \"  ║  📡 Ethernet assente — WiFi hotspot attivo   ║\"
echo \"  ║                                              ║\"
echo \"  ║  Connettiti al WiFi:                         ║\"
echo \"  ║    Rete:     Camera-Viewer                   ║\"
echo \"  ║    Password: cameraviewer                    ║\"
echo \"  ║                                              ║\"
echo \"  ║  Poi apri nel browser:                       ║\"
echo \"  ║    http://${AP_IP}                      ║\"
echo \"  ║                                              ║\"
echo \"  ║  Login: admin / admin                        ║\"
echo \"  ╚══════════════════════════════════════════════╝\"
sleep 30
done
' &
" 2>/dev/null &

#!/usr/bin/env python3
"""cv-bootmode — decide and apply the boot mode at startup.

Runs as root from camera-bootmode.service after NetworkManager is up.

  PROVISIONING  (no cameras configured, OR a force-setup flag is present):
      - bring up the Access Point + captive portal
      - make sure the viewer is not running

  OPERATIONAL   (cameras configured and no force-setup flag):
      - tear down the Access Point
      - let NetworkManager auto-connect ethernet/WiFi
      - start the viewer (kiosk)

The web config server (port 80) runs independently in both modes, so the
device can always be reconfigured.
"""
from __future__ import annotations

import json
import os
import pwd
import subprocess
from pathlib import Path


def _kiosk_home() -> str:
    """Trova la home del primo utente desktop (UID 1000-1999)."""
    env = os.environ.get("CAMERA_VIEWER_CONFIG")
    if env:
        return str(Path(env).parent.parent.parent)
    for pw in pwd.getpwall():
        if 1000 <= pw.pw_uid < 65534 and pw.pw_dir.startswith("/home"):
            return pw.pw_dir
    return "/home/ubuntu"   # fallback sicuro per NUC Ubuntu


CONFIG = Path(os.environ.get(
    "CAMERA_VIEWER_CONFIG",
    f"{_kiosk_home()}/.config/camera-viewer/config.json",
))
FORCE_SETUP = CONFIG.parent / "force-setup"


def should_provision() -> bool:
    if FORCE_SETUP.exists():
        return True
    try:
        cfg = json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return True
    return len(cfg.get("cameras", [])) == 0


def run(*args: str) -> None:
    subprocess.run(list(args), check=False)


def main() -> None:
    # Note: the graphical viewer is started by the desktop session autostart
    # (cv-viewer-launch), which needs access to the user's Wayland display.
    # Here we only toggle the Access Point.
    if should_provision():
        run("/usr/local/sbin/cv-ap", "start")
        print("MODE=provisioning")
    else:
        run("/usr/local/sbin/cv-ap", "stop")
        print("MODE=operational")


if __name__ == "__main__":
    main()

#!/bin/bash
# cv-viewer-launch — start the Camera Viewer in kiosk mode on the monitor.
#
# Launched by the desktop session autostart (labwc) as user pi, so it has the
# Wayland display. It starts the viewer ONLY in operational mode: cameras
# configured AND no force-setup flag. In provisioning mode it does nothing
# (the captive portal / AP handle setup).
#
# SINGLE-INSTANCE: a flock guard guarantees only one supervisor loop runs at
# any time. Both the desktop autostart and the portal's "restart viewer" call
# this script; flock ensures the second caller exits immediately instead of
# spawning a competing loop. To restart the viewer, the portal just kills the
# inner `python3 main.py` — this supervisor's loop relaunches it.
#
# Uses absolute paths (NOT $HOME): the labwc autostart environment may not
# export HOME, which previously made the force-setup check fail.
# Usa $HOME se disponibile (sessione utente), altrimenti rileva il primo utente
# con UID >= 1000 (coerente con cv-bootmode e install-camera-viewer.sh)
_KIOSK_HOME="${HOME:-$(getent passwd | awk -F: '$3>=1000 && $3<65534 && $6~/^\/home/{print $6; exit}')}"
_KIOSK_HOME="${_KIOSK_HOME:-/home/ubuntu}"
CFG_DIR="${_KIOSK_HOME}/.config/camera-viewer"
# Native X11 session (rpd-x via lightdm). No XWayland overhead.
# mpv --vo=gpu works for all embedded windows on X11.
export QT_QPA_PLATFORM=xcb
export DISPLAY="${DISPLAY:-:0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# NUC / Intel Quick Sync: abilita VAAPI sempre (grid + zoom).
# Su Pi questi restano non impostati → si usa hwdec=auto-safe+x11egl.
# Possono essere sovrascritti dall'autostart del desktop (openbox/labwc).
export CV_HWDEC_BACKEND="${CV_HWDEC_BACKEND-}"
export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME-}"

# Set monitor to 1080p@50Hz via xrandr (X11 session, not Wayland).
# 50Hz = 2×25fps → no judder with 25fps camera streams.
xrandr --output HDMI-1 --mode 1920x1080 --rate 50 2>/dev/null || true
export CAMERA_VIEWER_CONFIG="$CFG_DIR/config.json"

# Single-instance guard: if another supervisor already holds the lock, exit.
# fd 9 stays open for the lifetime of this process (and the loop), so the lock
# is held until the supervisor exits.
exec 9>/tmp/cv-viewer-launch.lock
flock -n 9 || exit 0

cd "${_KIOSK_HOME}/camera-viewer" || exit 0

# Usa il venv se disponibile (NUC/Ubuntu), altrimenti python3 di sistema (Pi)
PYTHON3="python3"
[ -x ".venv/bin/python3" ] && PYTHON3=".venv/bin/python3"

# ── Mostra IP del portale su schermo al boot ────────────────────────────────
# Aspetta max 15s che la rete sia disponibile, poi mostra l'IP con xterm/OSD.
# Si chiude automaticamente dopo 10s o quando l'utente configura telecamere.
_show_ip_overlay() {
    local ip timeout=15
    for i in $(seq 1 $timeout); do
        ip=$(hostname -I 2>/dev/null | awk '{print $1}')
        [ -n "$ip" ] && break
        sleep 1
    done

    # Controlla se siamo in modalità AP (nessun ethernet, hotspot attivo)
    local ap_mode=""
    if [ -f /tmp/cv-ap-mode ]; then
        ap_mode=$(cat /tmp/cv-ap-mode)  # formato: SSID|IP
    fi

    local content
    if [ -n "$ap_mode" ]; then
        # Modalità hotspot WiFi
        local ssid="${ap_mode%%|*}"
        local ap_ip="${ap_mode##*|}"
        # Non mostrare la password AP a schermo: è nel file /etc/cv-ap-psk (root-only).
        # L'installatore deve recuperarla tramite SSH o etichetta fisica.
        content="echo ''
echo '  ╔═══════════════════════════════════════════╗'
echo '  ║   🎥  Camera Viewer v2.5                  ║'
echo '  ╠═══════════════════════════════════════════╣'
echo '  ║  📡 Nessun ethernet — Hotspot WiFi attivo  ║'
echo '  ║                                           ║'
echo '  ║   1. Connettiti al WiFi: ${ssid}       ║'
echo '  ║      (password: vedi etichetta NUC)       ║'
echo '  ║   2. Apri:  http://${ap_ip}          ║'
echo '  ║   3. Login: admin / admin                 ║'
echo '  ╚═══════════════════════════════════════════╝'
sleep 60"
    elif [ -n "$ip" ]; then
        # Modalità ethernet normale
        content="echo ''
echo '  ╔═══════════════════════════════════════════╗'
echo '  ║   🎥  Camera Viewer v2.5                  ║'
echo '  ║       di Enzo Pellegrino                  ║'
echo '  ╠═══════════════════════════════════════════╣'
echo '  ║   Portale:  http://${ip}          ║'
echo '  ║   Login:    admin / admin                 ║'
echo '  ╚═══════════════════════════════════════════╝'
echo ''
echo '  (si chiude in 10 secondi...)'
sleep 10"
    else
        # Nessuna rete dopo 15s: mostra comunque un messaggio di stato
        xterm -T "Camera Viewer" \
              -fa "Monospace" -fs 16 \
              -bg "#0c0e18" -fg "#f7a74f" \
              -geometry 55x8+0+0 \
              -e bash -c "echo ''
echo '  ╔═══════════════════════════════════════════╗'
echo '  ║   🎥  Camera Viewer v2.5                  ║'
echo '  ╠═══════════════════════════════════════════╣'
echo '  ║   ⚠  Nessuna rete rilevata               ║'
echo '  ║   Collega un cavo ethernet e riavvia      ║'
echo '  ╚═══════════════════════════════════════════╝'
sleep 60" &
        return
    fi

    xterm -T "Camera Viewer" \
          -fa "Monospace" -fs 16 \
          -bg "#0c0e18" -fg "#4f72f7" \
          -geometry 55x10+0+0 \
          -e bash -c "$content" &
}

# Mostra l'IP solo se non ci sono ancora telecamere configurate
if ! $PYTHON3 -c "import json,sys; sys.exit(0 if json.load(open('$CFG_DIR/config.json')).get('cameras') else 1)" 2>/dev/null; then
    _show_ip_overlay
fi

# Supervisor loop:
#  - Provisioning (no telecamere): aspetta in loop finché non vengono configurate.
#    La sessione openbox resta viva; il portale web (camera-webconfig) è già in
#    ascolto; l'overlay hotspot/IP viene rimostrato ogni ~60s per evitare schermo nero.
#  - Operativo (telecamere presenti): avvia main.py e riavvia se crasha.
_OVERLAY_TICK=0
while true; do
  [ -f "$CFG_DIR/force-setup" ] && break

  if ! $PYTHON3 -c "import json,sys; sys.exit(0 if json.load(open('$CFG_DIR/config.json')).get('cameras') else 1)" 2>/dev/null; then
    # Nessuna telecamera ancora: siamo in provisioning.
    # Rimostra l'overlay ogni 60s per evitare schermo nero indefinito.
    _OVERLAY_TICK=$(( _OVERLAY_TICK + 1 ))
    [ $(( _OVERLAY_TICK % 6 )) -eq 0 ] && _show_ip_overlay
    sleep 10
    continue
  fi

  $PYTHON3 main.py >>/tmp/viewer.log 2>&1

  sleep 2
done
